{
  "name": "@kumix/better-auth-ui",
  "version": "0.1.0",
  "description": "Kumix better-auth UI kit: prebuilt auth views, client plugins, and react-email templates for better-auth, styled with @kumix/ui (shadcn/ui, Base UI). Per-file ESM exports.",
  "author": "Kumix Labs <hai@kumix.io>",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    "./css": {
      "types": "./dist/style.css.d.ts",
      "default": "./dist/style.css"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "./lib/*": {
      "types": "./dist/lib/*.d.ts",
      "default": "./dist/lib/*.js"
    }
  },
  "scripts": {
    "clean": "rimraf dist",
    "clean:all": "rimraf .turbo dist node_modules",
    "dev": "tsdown --watch",
    "build:css": "cp src/style.css dist/style.css && cp src/style.css.d.ts dist/style.css.d.ts",
    "build": "rimraf dist && mkdir -p dist && bun run build:css && tsdown && publint",
    "types:check": "tsc --noEmit"
  },
  "homepage": "https://github.com/kumixlabs/better-auth-starterkit",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kumixlabs/better-auth-starterkit.git",
    "directory": "packages/ui"
  },
  "bugs": {
    "url": "https://github.com/kumixlabs/better-auth-starterkit/issues"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "kumix",
    "better-auth",
    "auth",
    "authentication",
    "login",
    "sign-in",
    "sign-up",
    "react",
    "ui",
    "components",
    "organization",
    "two-factor",
    "shadcn",
    "base-ui"
  ],
  "devDependencies": {
    "@better-auth-ui/core": "^1.7.23",
    "@better-auth-ui/react": "^1.7.23",
    "@kumix/tsconfig": "^0.1.0",
    "@kumix/ui": "^0.3.16",
    "@kumix/utils": "^0.3.0",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-pacer": "^0.23.0",
    "@tanstack/react-query": "^5.103.1",
    "@tanstack/react-store": "^0.11.1",
    "@tanstack/react-table": "^9.2.4",
    "@types/react": "^19.3.0",
    "better-auth": "^1.7.5",
    "bowser": "^2.14.1",
    "class-variance-authority": "^0.7.1",
    "date-fns": "^4.4.0",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.46.0",
    "react": "^19.3.0",
    "react-day-picker": "^10.0.1",
    "react-email": "^6.9.5",
    "tsdown": "^0.23.0",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "@better-auth-ui/core": ">=1.7.0",
    "@better-auth-ui/react": ">=1.7.0",
    "@kumix/ui": ">=0.3.16",
    "@kumix/utils": ">=0.3.0",
    "@tanstack/react-form": ">=1.33.0",
    "@tanstack/react-pacer": ">=0.23.0",
    "@tanstack/react-query": ">=5.100.0",
    "@tanstack/react-store": ">=0.11.0",
    "@tanstack/react-table": ">=9.2.0",
    "better-auth": ">=1.7.5",
    "bowser": ">=2.14.0",
    "class-variance-authority": ">=0.7.0",
    "date-fns": ">=4.4.0",
    "input-otp": ">=1.5.0",
    "lucide-react": ">=1.46.0",
    "react": ">=18.0.0 || >=19.0.0-rc.0",
    "react-day-picker": ">=10.0.0",
    "react-email": ">=6.9.0"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  }
}
